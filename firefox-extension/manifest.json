{
  "manifest_version": 3,
  "name": "AntiShorts",
  "version": "0.1.0",
  "description": "Blocks YouTube Shorts recommendation shelves and prevents moving between Shorts in the Shorts viewer.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "AntiShorts settings",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "antishorts@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content-script.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}